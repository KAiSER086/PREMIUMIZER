# =====================================================================
# PREMIUMIZER • Discord Bot & Premiumize Downloader Configuration
# =====================================================================

# 1. Discord Bot Token (from Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Bot Language (en = English default, de = German)
BOT_LANGUAGE=en

# 2. Premiumize API Key (https://www.premiumize.me/account)
PREMIUMIZE_API_KEY=YOUR_PREMIUMIZE_API_KEY_HERE

# 3. Default Stream Uploader for large files (gofile, pixeldrain, litterbox)
DEFAULT_UPLOADER=gofile

# 4. Optional API Keys / Tokens for Free Uploaders
PIXELDRAIN_API_KEY=
GOFILE_API_TOKEN=

# 5. Maximum Concurrent Download Tasks (Default: 2)
MAX_CONCURRENT_TASKS=2

# 6. Automatic Storage Cleanup after successful upload (Recommended: true)
AUTOCLEAN_LOCAL=true
AUTOCLEAN_PREMIUMIZE=true

# 7. Privacy & DM Notifications
# Channel messages are auto-deleted and live progress + finished downloads are delivered via DM!
EPHEMERAL_MODE=true
DM_NOTIFY_USER=true

# 8. Optional Admin Notifications & Audit Logs
# Telegram Audit Bot (Create your bot via @BotFather - leave empty if not needed):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Admin / Audit Log Channel ID (Leave empty if not needed):
ADMIN_USER_ID=
ADMIN_CHANNEL_ID=

# 9. Access Control Whitelists (Optional: Comma-separated Discord snowflake IDs. Leave empty for all!)
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=
ALLOWED_CHANNEL_IDS=
